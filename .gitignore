# --- Gradle / Android build output ---
.gradle/
build/
app/build/
app/release/
app/debug/
build-output/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab
*.aar
*.ap_
*.dex
local.properties

# CI staging dir (.github/workflows/release.yml collects APKs here)
dist/

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- Signing ---
# The committed debug keystore is the only exception, so every debug build signs
# identically and reinstalls never hit "signatures do not match".
*.jks
*.keystore
!keystore/debug.keystore
keystore.properties
*.p12
*.pem

# --- Secrets / local config ---
.env
.env.*
!.env.example
secrets.properties

# Captured logcat from a diagnostic run.
run.txt
*.logcat

# --- OS noise ---
.DS_Store
Thumbs.db
*~
*.swp

# --- Misc ---
*.hprof
*.log
