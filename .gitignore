# --- Gradle / Android build output ---
.gradle/
build/
app/build/
app/release/
app/debug/
build-output/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab
*.aar
*.ap_
*.dex
local.properties

# CI staging dir (.github/workflows/release.yml collects APKs here)
dist/

# --- IDE / assistant tooling ---
# Local scratch directories various editors and coding assistants create in the
# repo root. None of them belong in the history.
.idea/
.vscode/
.claude/
.cursor/
.aider*
.continue/
.windsurf/
*.iml
*.ipr
*.iws

# --- Signing ---
# The committed debug keystore is the only exception, so every debug build signs
# identically and reinstalls never hit "signatures do not match".
*.jks
*.keystore
!keystore/debug.keystore
keystore.properties
*.p12
*.pem

# --- Secrets / local config ---
.env
.env.*
!.env.example
secrets.properties

# --- Your own portfolio ---
# The app writes these from Settings > Data > Backup and restore. The .eddies
# file is passphrase-encrypted and the CSV is not, but neither belongs in a
# public repo, and the working directory is an easy place to drop one by
# accident.
*.eddies
eddies-*.csv
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Captured logcat from a diagnostic run.
run.txt
*.logcat

# --- OS noise ---
.DS_Store
Thumbs.db
*~
*.swp

# --- Misc ---
*.hprof
*.log
